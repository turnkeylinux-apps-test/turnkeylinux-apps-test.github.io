#!/bin/bash
# tkl-build-lxc by Daniele Lolli (UncleDan) feat. Claude AI - Release 1.0 - 2026-10-10 20-18-02
#
# Build a TurnKey appliance from a Git branch of its buildcode and turn it
# into a Proxmox LXC template, stopping at the first error:
#   1. checks, including the one-time buildtasks setup (done by
#      tkl-build-lxc-setup, which must have been run before)
#   2. clone of the buildcode repository (first time) or fetch, then checkout
#      of the requested branch, fast-forwarded to the remote one
#   3. check of the appliance name in the changelog
#   4. make clean && make                     -> build/product.iso
#   5. iso-release                            -> $BT_ISOS/<name>.iso(.hash)
#   6. bt-container                           -> $BT_BUILDS/container/*.tar.gz(.hash)
#   7. archive ISO, template and hashes with the ISO creation time (UTC)
#   8. verify the archived hashes
#
# Usage: tkl-build-lxc [-n] APPLIANCE BRANCH
#   APPLIANCE   buildcode repository, cloned from $GIT_BASE_URL/APPLIANCE.git
#               into $PRODUCTS_DIR/APPLIANCE (e.g. turnkey-moodle)
#   BRANCH      Git branch to build (e.g. moodle53-beta); it must match the
#               appliance name in the first line of the changelog
#               (turnkey-<BRANCH>-<version>)
#   -n          no clean: skip "make clean" (rebuild from the current state)
#
# Environment (defaults in brackets):
#   GIT_BASE_URL  base URL of the repositories
#                 [https://github.com/turnkeylinux-apps-test]
#   PRODUCTS_DIR  appliance buildcode directories [/turnkey/fab/products]
#   ARCHIVE_DIR   archive of renamed ISOs and templates [$PRODUCTS_DIR/mybuilds]
#   BT            buildtasks directory [/turnkey/buildtasks]
# BT_ISOS and BT_BUILDS are read from $BT/config/common.cfg.

set -Eeuo pipefail

APP=$(basename "$0")
STEP="start"

info()  { echo "INFO [$APP]: $*"; }
fatal() { echo "FATAL [$APP]: $*" 1>&2; exit 1; }
step()  { STEP=$1; echo; echo "===== [$APP] $STEP ====="; }

# shellcheck disable=SC2154  # rc is assigned inside the trap
trap 'rc=$?; echo "FATAL [$APP]: step \"$STEP\" failed (exit $rc, line $LINENO): $BASH_COMMAND" 1>&2; exit $rc' ERR

usage() {
    sed -n '/^# Usage:/,/^# BT_ISOS/p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
}

no_clean=""
while getopts ":nh" opt; do
    case $opt in
        n) no_clean="yes" ;;
        h) usage ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[[ $# -eq 2 ]] || usage
appliance=$1
branch=$2

PRODUCTS_DIR=${PRODUCTS_DIR:-/turnkey/fab/products}
ARCHIVE_DIR=${ARCHIVE_DIR:-$PRODUCTS_DIR/mybuilds}
BT=${BT:-/turnkey/buildtasks}
GIT_BASE_URL=${GIT_BASE_URL:-https://github.com/turnkeylinux-apps-test}
src=$PRODUCTS_DIR/$appliance
repo_url=$GIT_BASE_URL/$appliance.git

# --------------------------------------------------------------------------
step "1/8 checks"

[[ $EUID -eq 0 ]] || fatal "must be run as root"
for cmd in git make turnkey-version sha256sum; do
    command -v "$cmd" >/dev/null || fatal "command not found: $cmd"
done
[[ -x $BT/bt-container && -x $BT/bin/iso-release ]] \
    || fatal "buildtasks not found in $BT"
[[ $appliance =~ ^[A-Za-z0-9._-]+$ ]] || fatal "invalid appliance name: $appliance"
[[ $branch =~ ^[a-z0-9-]+$ ]] \
    || fatal "branch '$branch': buildtasks accepts only lowercase letters, digits and hyphens"

# one-time setup (tkl-build-lxc-setup): checked here, never done here
setup_hint="run tkl-build-lxc-setup first"
[[ -f $BT/config/common.cfg ]] || fatal "$BT/config missing: $setup_hint"
# the config uses variables that may be unset (e.g. GITHUB_USER)
set +u
# shellcheck source=/dev/null
source "$BT/config/common.cfg"
set -u
[[ -n ${BT_ISOS:-} && -n ${BT_BUILDS:-} ]] \
    || fatal "BT_ISOS / BT_BUILDS not set in $BT/config/common.cfg"
[[ -d $BT_ISOS && -d $BT_BUILDS ]] || fatal "$BT_ISOS or $BT_BUILDS missing: $setup_hint"
sig=$BT/bin/generate-signature
if grep -q 'Unexpected filename' "$sig" && ! grep -q 'debian-\*-turnkey-\*.tar.gz' "$sig"; then
    fatal "generate-signature would stop bt-container: $setup_hint"
fi
mkdir -p "$ARCHIVE_DIR"

# --------------------------------------------------------------------------
step "2/8 repository $repo_url, branch $branch"

if [[ ! -e $src ]]; then
    info "cloning $repo_url into $src"
    git clone --quiet "$repo_url" "$src"
fi
cd "$src"
[[ $(git rev-parse --show-toplevel 2>/dev/null) == "$(pwd -P)" ]] \
    || fatal "$src is not the root of a Git repository"
origin=$(git remote get-url origin 2>/dev/null || true)
[[ ${origin%.git} == "${repo_url%.git}" ]] \
    || fatal "$src: origin is '$origin', expected '$repo_url'"
# build/ is generated by make: only changes to the buildcode count
if [[ -n $(git status --porcelain -- . ':(exclude)build') ]]; then
    git status --short -- . ':(exclude)build' 1>&2
    fatal "uncommitted changes in $src: commit or stash them first"
fi
git fetch --quiet --prune origin
git rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null \
    || fatal "branch '$branch' not found on $repo_url"
if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    git checkout --quiet "$branch"
    # stop if the local branch has commits that are not on the remote
    git merge --quiet --ff-only "origin/$branch" \
        || fatal "local branch '$branch' has diverged from origin/$branch"
else
    git checkout --quiet -b "$branch" --track "origin/$branch"
fi
info "$(git log -1 --format='HEAD %h %ad %s' --date=short)"

# --------------------------------------------------------------------------
step "3/8 appliance name in changelog"

line1=$(head -n 1 changelog)
[[ $line1 =~ ^turnkey-([a-z0-9-]+)-([0-9.]+)\  ]] \
    || fatal "changelog first line not valid for buildtasks: $line1"
cl_name=${BASH_REMATCH[1]}
cl_version=${BASH_REMATCH[2]}
[[ $cl_name == "$branch" ]] \
    || fatal "changelog names the appliance '$cl_name', branch is '$branch'"
info "appliance $cl_name, version $cl_version"

# --------------------------------------------------------------------------
step "4/8 build ISO (make)"

if [[ -z $no_clean ]]; then
    make clean
else
    info "-n: make clean skipped"
fi
make
[[ -f build/product.iso ]] || fatal "build/product.iso not created"
iso_time=$(date -u -r build/product.iso +%Y-%m-%d_%H-%MUTC)
name=$(turnkey-version build/root.sandbox)
[[ $name == "turnkey-$branch-"* ]] \
    || fatal "unexpected ISO name '$name' (expected turnkey-$branch-...)"
info "ISO $name, created $iso_time"

# --------------------------------------------------------------------------
step "5/8 publish ISO in $BT_ISOS (iso-release)"

"$BT/bin/iso-release" --force --no-screens "$BT_ISOS"
[[ -f $BT_ISOS/$name.iso && -f $BT_ISOS/$name.iso.hash ]] \
    || fatal "$name.iso or its .hash missing in $BT_ISOS"

# --------------------------------------------------------------------------
step "6/8 build LXC template (bt-container)"

container_dir=$BT_BUILDS/container
rm -f "$container_dir"/debian-*-turnkey-"${branch}"_*.tar.gz{,.hash,.buildenv}
"$BT/bt-container" "${name#turnkey-}"
shopt -s nullglob
templates=("$container_dir"/debian-*-turnkey-"${branch}"_*.tar.gz)
shopt -u nullglob
[[ ${#templates[@]} -eq 1 ]] \
    || fatal "expected one template for $branch in $container_dir, found ${#templates[@]}"

# --------------------------------------------------------------------------
step "7/8 archive in $ARCHIVE_DIR with ISO time $iso_time"

archived=()
for f in "$BT_ISOS/$name.iso" "${templates[0]}"; do
    b=$(basename "$f")
    case $b in
        *.iso) n=${b%.iso}_$iso_time.iso ;;
        *)     n=${b%.tar.gz}_$iso_time.tar.gz ;;
    esac
    [[ ! -e $ARCHIVE_DIR/$n ]] || fatal "$ARCHIVE_DIR/$n already exists"
    mv "$f" "$ARCHIVE_DIR/$n"
    if [[ -f $f.hash ]]; then
        # the hash file names the file: update it to the new name
        sed "s|$b|$n|g" "$f.hash" > "$ARCHIVE_DIR/$n.hash"
        rm "$f.hash"
    else
        (cd "$ARCHIVE_DIR" && sha256sum "$n" > "$n.hash")
    fi
    archived+=("$n")
    info "archived $n"
done

# --------------------------------------------------------------------------
step "8/8 verify archived hashes"

cd "$ARCHIVE_DIR"
for n in "${archived[@]}"; do
    sha256sum -c "$n.hash" 2>/dev/null | grep -q "^$n: OK$" \
        || fatal "hash verification failed: $n"
    info "$n: OK"
done

trap - ERR
echo
info "done: $branch ($cl_version) built at $iso_time"
for n in "${archived[@]}"; do ls -lh "$ARCHIVE_DIR/$n" "$ARCHIVE_DIR/$n.hash"; done
